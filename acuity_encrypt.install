<?php

/**
 * @file
 * Install and uninstall hooks for Acuity Encrypt.
 *
 * No custom DB tables are needed — the field type uses Backdrop's Field API
 * storage. This file only manages the CMI config file lifecycle.
 */

/**
 * Implements hook_install().
 */
function acuity_encrypt_install(): void {
  config('acuity_encrypt.settings')
    ->set('key_storage_method', 'settings_php')
    ->set('external_file_path', '')
    ->save();

  config('acuity_encrypt.slots')
    ->set('active_slot', 1)
    ->set('slots', [
      1 => ['label' => 'Default', 'storage' => 'settings_php', 'external_path' => ''],
    ])
    ->save();
}

/**
 * Implements hook_uninstall().
 */
function acuity_encrypt_uninstall(): void {
  $config_directory = config_get_config_directory('active');
  foreach (['acuity_encrypt.settings.json', 'acuity_encrypt.slots.json'] as $filename) {
    $file = $config_directory . '/' . $filename;
    if (file_exists($file)) {
      unlink($file);
    }
  }
  state_del('acuity_encrypt_missing_key_slots');
  state_del('acuity_encrypt_orphan_values');
}

/**
 * Create the key slot registry from the legacy single-slot settings.
 */
function acuity_encrypt_update_1000(): void {
  $slots = config_get('acuity_encrypt.slots', 'slots');
  if (!empty($slots)) {
    return;
  }
  $legacy = config('acuity_encrypt.settings');
  config('acuity_encrypt.slots')
    ->set('active_slot', 1)
    ->set('slots', [
      1 => [
        'label' => 'Default',
        'storage' => $legacy->get('key_storage_method') ?: 'settings_php',
        'external_path' => $legacy->get('external_file_path') ?: '',
      ],
    ])
    ->save();
}
