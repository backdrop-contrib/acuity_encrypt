/**
 * Implements hook_menu().
 */
function acuity_encrypt_menu(): array {
  $items = [];

  // Shared Acuity Utils landing page — other acuity_* modules declare this too;
  // Backdrop deduplicates by path so only one definition wins.
  $items['admin/config/acuity-utils'] = [
    'title'           => 'Acuity Utils',
    'description'     => 'Acuity standalone utilities configuration.',
    'page callback'   => 'system_admin_menu_block_page',
    'access arguments'=> ['access administration pages'],
    'file'            => 'system.admin.inc',
    'file path'       => backdrop_get_path('module', 'system'),
    'position'        => 'right',
    'weight'          => -10,
  ];

  // Main page — key slots overview.
  $items['admin/config/acuity-utils/acuity_encrypt'] = [
    'title'            => 'Encryption Settings',
    'description'      => 'Manage encryption keys and check key status.',
    'page callback'    => 'acuity_encrypt_keys_overview',
    'access arguments' => ['administer acuity_encrypt'],
    'file'             => 'acuity_encrypt.admin.inc',
    'type'             => MENU_NORMAL_ITEM,
    'weight'           => 20,
  ];

  // "View keys" tab — default local task, shares the parent path and callback.
  $items['admin/config/acuity-utils/acuity_encrypt/keys'] = [
    'title'  => 'View keys',
    'type'   => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  ];

  // "Set keys" tab — the accordion settings form.
  $items['admin/config/acuity-utils/acuity_encrypt/settings'] = [
    'title'            => 'Set keys',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => ['acuity_encrypt_admin_form'],
    'access arguments' => ['administer acuity_encrypt'],
    'file'             => 'acuity_encrypt.admin.inc',
    'type'             => MENU_LOCAL_TASK,
    'weight'           => 10,
  ];

  // AJAX-only: returns the raw active key as JSON, fetched on demand from the
  // "Reveal key" button so the key never sits in the settings page's markup.
  $items['admin/config/acuity-utils/acuity_encrypt/reveal-key'] = [
    'page callback'    => 'acuity_encrypt_reveal_key_callback',
    'access arguments' => ['administer acuity_encrypt'],
    'file'             => 'acuity_encrypt.admin.inc',
    'type'             => MENU_CALLBACK,
    'delivery callback'=> 'backdrop_json_output',
  ];

  // ── Slot management (Phase 2) ─────────────────────────────────────────────

  $items['admin/config/acuity-utils/acuity_encrypt/slots/add'] = [
    'title'            => 'Add key slot',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => ['acuity_encrypt_slot_form'],
    'access arguments' => ['administer acuity_encrypt'],
    'file'             => 'acuity_encrypt.admin.inc',
    'type'             => MENU_CALLBACK,
  ];

  $items['admin/config/acuity-utils/acuity_encrypt/slots/%/edit'] = [
    'title'            => 'Edit key slot',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => ['acuity_encrypt_slot_form', 5],
    'access arguments' => ['administer acuity_encrypt'],
    'file'             => 'acuity_encrypt.admin.inc',
    'type'             => MENU_CALLBACK,
  ];

  $items['admin/config/acuity-utils/acuity_encrypt/slots/%/activate'] = [
    'title'            => 'Set active key slot',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => ['acuity_encrypt_slot_activate_confirm', 5],
    'access arguments' => ['administer acuity_encrypt'],
    'file'             => 'acuity_encrypt.admin.inc',
    'type'             => MENU_CALLBACK,
  ];

  $items['admin/config/acuity-utils/acuity_encrypt/rotate'] = [
    'title'            => 'Rotate encryption keys',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => ['acuity_encrypt_rotate_form'],
    'access arguments' => ['administer acuity_encrypt'],
    'file'             => 'acuity_encrypt.rotate.inc',
    'type'             => MENU_CALLBACK,
  ];

  return $items;
}

/**
 * Implements hook_init().
 *
 * Shows a prominent warning on ALL admin pages when encrypted data exists
 * whose key slot has no key configured. Reads a cheap state flag maintained
 * by acuity_encrypt_slot_value_counts() (recomputed on cron, on the keys
 * overview page, and after rotation) — no counting queries run here.
 */
function acuity_encrypt_init(): void {
  if (!function_exists('path_is_admin') || !path_is_admin(current_path())) {
    return;
  }
  if (!user_access('administer acuity_encrypt')) {
    return;
  }

  $missing = state_get('acuity_encrypt_missing_key_slots', []);
  if (!empty($missing)) {
    backdrop_set_message(t(
      '<strong>Encrypted data cannot be read:</strong> key slot(s) @slots have encrypted values in the database but no key configured. Restore the key(s) immediately — without them that data is unreadable. <a href="@url">Encryption Settings</a>',
      ['@slots' => implode(', ', $missing), '@url' => url('admin/config/acuity-utils/acuity_encrypt')]
    ), 'error', FALSE);
  }
}

/**
 * Implements hook_cron().
 *
 * Recomputes per-slot value counts so the admin-page missing-key warning
 * stays current even if nobody visits the keys overview page.
 */
function acuity_encrypt_cron(): void {
  acuity_encrypt_slot_value_counts();
}

/**
 * Implements hook_permission().
 */
function acuity_encrypt_permission(): array {
  return [
    'administer acuity_encrypt' => [
      'title'           => t('Administer Acuity Encrypt'),
      'description'     => t('Manage encryption key settings.'),
      'restrict access' => TRUE,
    ],
    'view encrypted fields' => [
      'title'           => t('View encrypted field values'),
      'description'     => t('Decrypt and reveal encrypted field content on display.'),
      'restrict access' => TRUE,
    ],
  ];
}

/**
 * Implements hook_config_info().
 */
function acuity_encrypt_config_info(): array {
  return [
    'acuity_encrypt.slots' => [
      'label' => t('Acuity Encrypt key slot registry'),
      'group' => t('Configuration'),
    ],
  ];
}

/**
 * Implements hook_entity_info_alter().
 *
 * Disables persistent entity/field caching for any bundle that contains an
 * encrypted field. hook_field_attach_load() decrypts entity values in place,
 * and core writes entities to the persistent caches AFTER that hook runs —
 * without this, decrypted plaintext would be stored in the cache_entity_* /
 * cache_field database tables (defeating at-rest encryption), and because
 * those caches are shared across users, the permission-gated decrypt would
 * cache whatever the first loader was allowed to see.
 *
 * Instance configs are read directly rather than via field_info_instances()
 * because the field info system itself consumes entity info — calling it
 * from this alter hook would recurse.
 */
function acuity_encrypt_entity_info_alter(array &$entity_info): void {
  foreach (config_get_names_with_prefix('field.instance.') as $config_name) {
    $instance = config_get($config_name);
    if (($instance['widget']['type'] ?? '') !== 'acuity_encrypt_widget' || !empty($instance['deleted'])) {
      continue;
    }
    $entity_type = $instance['entity_type'];
    if (!isset($entity_info[$entity_type])) {
      continue;
    }
    // 'field cache' is per entity type; 'bundle cache' (persistent entity
    // cache writes) is per bundle.
    $entity_info[$entity_type]['field cache'] = FALSE;
    if (isset($entity_info[$entity_type]['bundles'][$instance['bundle']])) {
      $entity_info[$entity_type]['bundles'][$instance['bundle']]['bundle cache'] = FALSE;
    }
  }
}

/**
 * Implements hook_field_create_instance().
 */
function acuity_encrypt_field_create_instance(array $instance): void {
  if (($instance['widget']['type'] ?? '') === 'acuity_encrypt_widget') {
    _acuity_encrypt_caching_flags_changed($instance['entity_type']);
  }
}

/**
 * Implements hook_field_update_instance().
 */
function acuity_encrypt_field_update_instance(array $instance, array $prior_instance): void {
  $was = ($prior_instance['widget']['type'] ?? '') === 'acuity_encrypt_widget';
  $now = ($instance['widget']['type'] ?? '') === 'acuity_encrypt_widget';
  if ($was !== $now) {
    _acuity_encrypt_caching_flags_changed($instance['entity_type']);
  }
}

/**
 * Implements hook_field_delete_instance().
 */
function acuity_encrypt_field_delete_instance(array $instance): void {
  if (($instance['widget']['type'] ?? '') === 'acuity_encrypt_widget') {
    _acuity_encrypt_caching_flags_changed($instance['entity_type']);
  }
}

/**
 * Rebuilds entity info and purges caches after encryption is toggled on a
 * bundle (instance created/deleted, or its widget switched to/from the
 * encrypt widget).
 *
 * Entity info must be rebuilt so acuity_encrypt_entity_info_alter() can
 * (re)apply the no-persistent-cache flags, and existing cache entries are
 * purged because they may hold plaintext written before the flags applied.
 */
function _acuity_encrypt_caching_flags_changed(string $entity_type): void {
  entity_info_cache_clear();
  $table = 'cache_entity_' . $entity_type;
  if (db_table_exists($table)) {
    db_truncate($table)->execute();
  }
  if (db_table_exists('cache_field')) {
    db_truncate('cache_field')->execute();
  }
}

// ── Internal helpers ──────────────────────────────────────────────────────────

/**
 * Returns a 32-byte binary key for the given slot, or NULL if unavailable.
 *
 * Priority order:
 *   1. $settings['acuity_encrypt_key{slot}'] in settings.php — always checked
 *      first for every slot, regardless of the slot's registered storage.
 *   2. The storage registered for the slot in acuity_encrypt.slots.json:
 *      a. 'external_file' — per-slot absolute path; file created manually.
 *      b. 'private_file'  — private://keys/acuity_encrypt_key{slot}.key.
 *
 * Keys are hashed with SHA-256 to a fixed 32-byte AES key, so any length
 * passphrase or hex string is acceptable as the raw value.
 *
 * Keys are never stored in CMI config or the database.
 *
 * @param int $slot
 *   Key slot identifier.
 */
function _acuity_encrypt_get_key(int $slot = 1): string|null {
  global $settings;

  // 1. settings.php — preferred, never in DB or config exports.
  // Key name matches the slot number: acuity_encrypt_key1, acuity_encrypt_key2, etc.
  // This mirrors the private/external file naming so all methods are consistent.
  $settings_key_name = 'acuity_encrypt_key' . $slot;
  if (!empty($settings[$settings_key_name])) {
    return hash('sha256', $settings[$settings_key_name], TRUE);
  }

  $registry = acuity_encrypt_slots();
  if (!isset($registry['slots'][$slot])) {
    return NULL;
  }
  $storage = $registry['slots'][$slot]['storage'];

  // 2a. External file — per-slot path stored in the slot registry.
  if ($storage === 'external_file') {
    $path = $registry['slots'][$slot]['external_path'];
    if (!empty($path) && is_readable($path)) {
      $raw = trim(file_get_contents($path));
      if (!empty($raw)) {
        return hash('sha256', $raw, TRUE);
      }
    }
    return NULL;
  }

  // 2b. Private file — written by the module via the admin UI.
  if ($storage === 'private_file') {
    $uri      = 'private://keys/acuity_encrypt_key' . $slot . '.key';
    $realpath = backdrop_realpath($uri);
    if ($realpath && is_readable($realpath)) {
      $raw = trim(file_get_contents($realpath));
      if (!empty($raw)) {
        return hash('sha256', $raw, TRUE);
      }
    }
    return NULL;
  }

  // settings_php storage selected but key not found in settings.php.
  return NULL;
}

// ── Key slot registry ─────────────────────────────────────────────────────────

/**
 * Returns the slot registry: active slot id + per-slot storage config.
 *
 * Backed by acuity_encrypt.slots.json. When the registry is empty (config
 * file missing or blank), a default slot 1 is returned so key lookups never
 * fatal.
 *
 * @return array
 *   ['active_slot' => int, 'slots' => [id => [label, storage, external_path]]]
 */
function acuity_encrypt_slots(): array {
  /** @var array|null $registry */
  $registry = &backdrop_static(__FUNCTION__);
  if ($registry !== NULL) {
    return $registry;
  }

  $config = config('acuity_encrypt.slots');
  $slots = $config->get('slots');
  $active = (int) ($config->get('active_slot') ?: 1);

  if (empty($slots)) {
    $registry = [
      'active_slot' => 1,
      'slots' => [
        1 => ['label' => 'Default', 'storage' => 'settings_php', 'external_path' => ''],
      ],
    ];
    return $registry;
  }

  // JSON object keys arrive as strings; normalize and apply defaults.
  $normalized = [];
  foreach ($slots as $id => $info) {
    $normalized[(int) $id] = (array) $info + [
      'label' => 'Slot ' . $id,
      'storage' => 'settings_php',
      'external_path' => '',
    ];
  }
  ksort($normalized);

  if (!isset($normalized[$active])) {
    $active = (int) array_key_first($normalized);
  }

  $registry = ['active_slot' => $active, 'slots' => $normalized];
  return $registry;
}

/**
 * Returns the active key slot id — the slot all new encryptions use.
 */
function acuity_encrypt_active_slot(): int {
  $registry = acuity_encrypt_slots();
  return $registry['active_slot'];
}

/**
 * Writes (or merges) one slot's storage config into the registry.
 *
 * @param int $slot
 *   Slot id.
 * @param array $info
 *   Any of: label, storage, external_path. Merged over existing values.
 */
function _acuity_encrypt_registry_set_slot(int $slot, array $info): void {
  $registry = acuity_encrypt_slots();
  $existing = $registry['slots'][$slot] ?? ['label' => 'Slot ' . $slot, 'storage' => 'settings_php', 'external_path' => ''];
  $registry['slots'][$slot] = $info + $existing;

  config('acuity_encrypt.slots')
    ->set('active_slot', $registry['active_slot'])
    ->set('slots', $registry['slots'])
    ->save();
  backdrop_static_reset('acuity_encrypt_slots');
}

/**
 * Maps every field instance using the encrypt widget to its SQL storage.
 *
 * @return array
 *   [field_name => ['columns' => [...], 'tables' => [data_table, revision_table]]]
 */
function acuity_encrypt_encrypted_field_map(): array {
  $map = [];
  foreach (field_info_fields() as $field_name => $field) {
    if (!in_array($field['type'], ['text', 'text_long', 'text_with_summary'], TRUE)) {
      continue;
    }
    $used = FALSE;
    foreach (($field['bundles'] ?? []) as $entity_type => $bundles) {
      foreach ($bundles as $bundle) {
        $instance = field_info_instance($entity_type, $field_name, $bundle);
        if ($instance && $instance['widget']['type'] === 'acuity_encrypt_widget') {
          $used = TRUE;
          break 2;
        }
      }
    }
    if (!$used) {
      continue;
    }
    $columns = [$field_name . '_value'];
    if ($field['type'] === 'text_with_summary') {
      $columns[] = $field_name . '_summary';
    }
    $map[$field_name] = [
      'columns' => $columns,
      'tables' => ['field_data_' . $field_name, 'field_revision_' . $field_name],
    ];
  }
  return $map;
}

/**
 * Counts encrypted values per slot across all encrypted fields.
 *
 * Counts BOTH current (field_data_*) and revision (field_revision_*) rows —
 * a slot's key can only be retired when its revisions are re-encrypted too.
 * Counts are computed live from the database (they are environment facts,
 * not config, so they are never stored in config exports); the result is
 * cached in state for the cheap admin-page missing-key check.
 *
 * @return array
 *   ['slots' => [slot_id => count], 'orphan' => int, 'total' => int]
 *   'orphan' counts enc{N}: values whose slot N is not in the registry.
 */
function acuity_encrypt_slot_value_counts(): array {
  $registry = acuity_encrypt_slots();
  $slot_ids = array_keys($registry['slots']);
  $counts = array_fill_keys($slot_ids, 0);
  $total = 0;

  foreach (acuity_encrypt_encrypted_field_map() as $info) {
    foreach ($info['tables'] as $table) {
      if (!db_table_exists($table)) {
        continue;
      }
      foreach ($info['columns'] as $column) {
        $total += (int) db_query(
          "SELECT COUNT(*) FROM {" . $table . "} WHERE $column REGEXP :re",
          [':re' => '^enc[0-9]+:']
        )->fetchField();
        foreach ($slot_ids as $sid) {
          $counts[$sid] += (int) db_query(
            "SELECT COUNT(*) FROM {" . $table . "} WHERE $column LIKE :prefix",
            [':prefix' => 'enc' . $sid . ':%']
          )->fetchField();
        }
      }
    }
  }

  $result = [
    'slots' => $counts,
    'orphan' => max(0, $total - array_sum($counts)),
    'total' => $total,
  ];

  // Refresh the cheap missing-key flag read by hook_init() on admin pages.
  $missing = [];
  foreach ($slot_ids as $sid) {
    if ($counts[$sid] > 0 && _acuity_encrypt_get_key($sid) === NULL) {
      $missing[] = $sid;
    }
  }
  state_set('acuity_encrypt_missing_key_slots', $missing);
  state_set('acuity_encrypt_orphan_values', $result['orphan']);

  return $result;
}

/**
 * Derives a slot's display status.
 *
 * @return string
 *   'active'       — key available, this is the active slot.
 *   'in_use'       — key available, holds data, not active. Key must stay.
 *   'available'    — key available, zero values. Safe to retire or reuse.
 *   'missing'      — DATA EXISTS but no key. Admin must restore it now.
 *   'unconfigured' — no key and no data.
 */
function acuity_encrypt_slot_status(int $slot, array $counts): string {
  $key_available = _acuity_encrypt_get_key($slot) !== NULL;
  $count = $counts['slots'][$slot] ?? 0;
  if (!$key_available) {
    return $count > 0 ? 'missing' : 'unconfigured';
  }
  if ($slot === acuity_encrypt_active_slot()) {
    return 'active';
  }
  return $count > 0 ? 'in_use' : 'available';
}
