<?php

/**
 * @file
 * Install and uninstall hooks for Acuity Encrypt.
 *
 * No custom DB tables are needed — the field type uses Backdrop's Field API
 * storage. This file only manages the CMI config file lifecycle.
 */

/**
 * Implements hook_install().
 */
function acuity_encrypt_install(): void {
  config('acuity_encrypt.slots')
    ->set('active_slot', 1)
    ->set('slots', [
      1 => ['label' => 'Default', 'storage' => 'settings_php', 'external_path' => ''],
    ])
    ->save();
}

/**
 * Implements hook_uninstall().
 */
function acuity_encrypt_uninstall(): void {
  $config_directory = config_get_config_directory('active');
  $file = $config_directory . '/acuity_encrypt.slots.json';
  if (file_exists($file)) {
    unlink($file);
  }
  state_del('acuity_encrypt_missing_key_slots');
  state_del('acuity_encrypt_orphan_values');
}

/**
 * Delete the legacy single-slot acuity_encrypt.settings config.
 *
 * The slot registry (acuity_encrypt.slots) is the sole source of truth;
 * the pre-multi-slot config file and its update_1000() migration are gone.
 */
function acuity_encrypt_update_1001(): void {
  config('acuity_encrypt.settings')->delete();
}

/**
 * Purge persistent caches that may hold decrypted plaintext.
 *
 * Before this release, hook_field_attach_load() decrypted entities BEFORE
 * core wrote them to the persistent entity/field caches, so cache_entity_*
 * and cache_field tables can contain plaintext copies of encrypted fields.
 * Caching is now disabled for encrypted bundles (hook_entity_info_alter);
 * this wipes what earlier code already persisted.
 */
function acuity_encrypt_update_1002(): void {
  foreach (array_keys(entity_get_info()) as $entity_type) {
    $table = 'cache_entity_' . $entity_type;
    if (db_table_exists($table)) {
      db_truncate($table)->execute();
    }
  }
  if (db_table_exists('cache_field')) {
    db_truncate('cache_field')->execute();
  }
  entity_info_cache_clear();
}
