<?php

/**
 * @file
 * Acuity Encrypt — AES-256-GCM field encryption for Backdrop CMS.
 *
 * Provides a public encryption API and an 'acuity_encrypted_text' field type.
 * Uses PHP's built-in OpenSSL extension — no external libraries required.
 *
 * Key configuration (add to settings.php for production):
 * @code
 *   $settings['acuity_encrypt_key1'] = 'your-long-random-secret';
 * @endcode
 *
 * Generate a suitable key:
 * @code
 *   php -r "echo bin2hex(random_bytes(32));"
 * @endcode
 */

module_load_include('inc', 'acuity_encrypt', 'acuity_encrypt.field');
module_load_include('inc', 'acuity_encrypt', 'acuity_encrypt.admin');
module_load_include('inc', 'acuity_encrypt', 'acuity_encrypt.actions');

// ── Public API ────────────────────────────────────────────────────────────────

/**
 * Encrypts a plaintext string using AES-256-GCM.
 *
 * The returned string is self-contained: it carries its own IV and
 * authentication tag, so each call produces a different ciphertext even for
 * identical input. Safe to store directly in a database column.
 *
 * Ciphertext format: enc{slot}:base64(iv[12] . tag[16] . ciphertext)
 * Example:           enc1:AAECAwQFBgcICQoL...
 *
 * The slot number identifies which key was used, so decryption always picks
 * the right key automatically — including during and after key rotation.
 *
 * @param string $plaintext
 *   The value to encrypt.
 * @param int|null $slot
 *   Key slot identifier, or NULL (default) to use the current active slot.
 *
 * @return string|false
 *   'enc{slot}:' + base64(iv . tag . ciphertext), or FALSE on failure.
 */
function acuity_encrypt_encrypt(string $plaintext, int|null $slot = NULL): string|false {
  if ($slot === NULL) {
    $slot = acuity_encrypt_active_slot();
  }
  $key = _acuity_encrypt_get_key($slot);
  if (!$key) {
    watchdog('acuity_encrypt', 'Encryption failed: no key configured for slot @slot.', ['@slot' => $slot], WATCHDOG_ERROR);
    return FALSE;
  }

  $iv  = random_bytes(12);
  $tag = '';
  $ciphertext = openssl_encrypt(
    $plaintext,
    'aes-256-gcm',
    $key,
    OPENSSL_RAW_DATA,
    $iv,
    $tag,
    '',
    16,
  );

  if ($ciphertext === FALSE) {
    watchdog('acuity_encrypt', 'openssl_encrypt() failed for slot @slot.', ['@slot' => $slot], WATCHDOG_ERROR);
    return FALSE;
  }

  return 'enc' . $slot . ':' . base64_encode($iv . $tag . $ciphertext);
}

/**
 * Decrypts a ciphertext string produced by acuity_encrypt_encrypt().
 *
 * The GCM authentication tag is verified automatically by OpenSSL; a tampered
 * or corrupted ciphertext returns FALSE. The key slot is read from the
 * ciphertext prefix so the correct key is always used automatically.
 *
 * @param string $ciphertext
 *   The 'enc{slot}:…' string to decrypt.
 *
 * @return string|false
 *   The original plaintext, or FALSE if decryption or tag verification fails.
 */
function acuity_encrypt_decrypt(string $ciphertext): string|false {
  if (!preg_match('/^enc(\d+):(.+)$/s', $ciphertext, $m)) {
    return FALSE;
  }

  $slot    = (int) $m[1];
  $encoded = $m[2];

  $key = _acuity_encrypt_get_key($slot);
  if (!$key) {
    return FALSE;
  }

  $raw = base64_decode($encoded, TRUE);
  // Minimum valid length: 12 (IV) + 16 (tag) = 28 bytes before ciphertext.
  if ($raw === FALSE || strlen($raw) < 28) {
    return FALSE;
  }

  $iv   = substr($raw, 0, 12);
  $tag  = substr($raw, 12, 16);
  $data = substr($raw, 28);

  return openssl_decrypt($data, 'aes-256-gcm', $key, OPENSSL_RAW_DATA, $iv, $tag);
}

/**
 * Encrypts a plaintext string with a caller-supplied key (AES-256-GCM).
 *
 * Same construction as acuity_encrypt_encrypt() but the caller owns the key
 * and the wire prefix: the return value is bare base64(iv . tag . ciphertext)
 * with NO 'enc{slot}:' prefix. Callers add their own prefix (e.g.
 * acuity_secure_link uses 'tok:' for token-derived-key payloads) so their
 * ciphertext can never be mistaken for slot-keyed ciphertext.
 *
 * @param string $plaintext
 *   The value to encrypt.
 * @param string $key
 *   Exactly 32 bytes of key material (e.g. from hash_hkdf()). Not a
 *   passphrase — no key derivation is applied here.
 *
 * @return string|false
 *   base64(iv[12] . tag[16] . ciphertext), or FALSE on failure.
 */
function acuity_encrypt_encrypt_with_key(string $plaintext, string $key): string|false {
  if (strlen($key) !== 32) {
    watchdog('acuity_encrypt', 'encrypt_with_key: key must be exactly 32 bytes, got @len.', ['@len' => strlen($key)], WATCHDOG_ERROR);
    return FALSE;
  }

  $iv  = random_bytes(12);
  $tag = '';
  $ciphertext = openssl_encrypt(
    $plaintext,
    'aes-256-gcm',
    $key,
    OPENSSL_RAW_DATA,
    $iv,
    $tag,
    '',
    16,
  );

  if ($ciphertext === FALSE) {
    watchdog('acuity_encrypt', 'openssl_encrypt() failed in encrypt_with_key.', [], WATCHDOG_ERROR);
    return FALSE;
  }

  return base64_encode($iv . $tag . $ciphertext);
}

/**
 * Decrypts a string produced by acuity_encrypt_encrypt_with_key().
 *
 * @param string $encoded
 *   The bare base64(iv . tag . ciphertext) string — strip any caller-added
 *   wire prefix before passing it in.
 * @param string $key
 *   The same 32 bytes of key material used to encrypt.
 *
 * @return string|false
 *   The original plaintext, or FALSE if decryption or tag verification fails.
 */
function acuity_encrypt_decrypt_with_key(string $encoded, string $key): string|false {
  if (strlen($key) !== 32) {
    return FALSE;
  }

  $raw = base64_decode($encoded, TRUE);
  // Minimum valid length: 12 (IV) + 16 (tag) = 28 bytes before ciphertext.
  if ($raw === FALSE || strlen($raw) < 28) {
    return FALSE;
  }

  $iv   = substr($raw, 0, 12);
  $tag  = substr($raw, 12, 16);
  $data = substr($raw, 28);

  return openssl_decrypt($data, 'aes-256-gcm', $key, OPENSSL_RAW_DATA, $iv, $tag);
}

/**
 * Returns TRUE if a value was produced by acuity_encrypt_encrypt().
 *
 * Checks the 'enc{digits}:' prefix AND that the remainder is valid base64
 * decoding to at least IV+tag length (28 bytes). A prefix match alone is not
 * enough: plaintext a user typed that happens to start with "enc1:" must
 * NOT be mistaken for ciphertext, or it would be skipped by the presave
 * double-encryption guard and stored unencrypted.
 *
 * @param string $value
 *   The string to test.
 *
 * @return bool
 */
function acuity_encrypt_is_encrypted(string $value): bool {
  if (!preg_match('/^enc\d+:(.+)$/s', $value, $m)) {
    return FALSE;
  }
  $raw = base64_decode($m[1], TRUE);
  // Minimum valid length: 12 (IV) + 16 (tag) = 28 bytes before ciphertext.
  return $raw !== FALSE && strlen($raw) >= 28;
}

/**
 * Returns the key slot number embedded in a ciphertext string, or NULL.
 *
 * @param string $ciphertext
 *   A value that may have been produced by acuity_encrypt_encrypt().
 *
 * @return int|null
 */
function acuity_encrypt_get_slot(string $ciphertext): int|null {
  return preg_match('/^enc(\d+):/', $ciphertext, $m) ? (int) $m[1] : NULL;
}

/**
 * Returns TRUE if an encryption key is available and encryption will work.
 *
 * @return bool
 */
function acuity_encrypt_key_available(): bool {
  return _acuity_encrypt_get_key() !== NULL;
}

/**
 * Returns the maximum plaintext BYTES that fit a column once encrypted.
 *
 * Stored format is 'enc{slot}:' + base64(iv[12] . tag[16] . ciphertext) and
 * GCM ciphertext length equals plaintext length, so:
 *   stored = prefix + 4 * ceil((28 + N) / 3)
 * Solving stored <= $max_length for N gives the limit below.
 *
 * Note this is bytes, not characters — multibyte UTF-8 characters count as
 * 2–4 bytes each.
 *
 * @param int $max_length
 *   The field/column maximum length (e.g. 255 for default text fields).
 * @param int|null $slot
 *   Slot whose prefix length to allow for; NULL = active slot.
 *
 * @return int
 *   Maximum plaintext bytes (0 if the column cannot hold any ciphertext).
 */
function acuity_encrypt_max_plaintext_bytes(int $max_length, int|null $slot = NULL): int {
  if ($slot === NULL) {
    $slot = acuity_encrypt_active_slot();
  }
  $prefix_length = strlen('enc' . $slot . ':');
  return max(0, ((int) floor(($max_length - $prefix_length) / 4)) * 3 - 28);
}

